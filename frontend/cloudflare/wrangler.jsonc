{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dfm-hq",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-20",
  "previews": {},
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
