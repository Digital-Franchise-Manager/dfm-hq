{
  "name": "dfm-hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=22.17.0 <25"
  },
  "workspaces": [
    "frontend",
    "apps/api",
    "packages/*",
    "backend/dfm/sports/drl/packages/*",
    "backend/dfm/sports/drl/classic/packages",
    "backend/dfm/sports/drl/draft/packages",
    "backend/dfm/sports/drl/persistence"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dfm/web",
    "build": "npm run typecheck && npm run build --workspace @dfm/web",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build --workspace @dfm/web"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
